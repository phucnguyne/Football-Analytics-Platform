{
  "name": "football-analytics-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "node packages/database/scripts/apply-env.mjs development --start",
    "apply:dev": "node packages/database/scripts/apply-env.mjs development",
    "apply:prod": "node packages/database/scripts/apply-env.mjs production",
    "build": "pnpm -r build",
    "start": "pnpm -r start",
    "lint": "pnpm -r lint",
    "type-check": "pnpm --filter @app/config build && tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "check": "pnpm lint && pnpm type-check && pnpm test --ci --runInBand",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @app/database run generate",
    "db:push": "pnpm --filter @app/database run push",
    "db:migrate": "pnpm --filter @app/database run migrate",
    "db:migrate:deploy": "pnpm --filter @app/database run migrate:deploy",
    "db:studio": "pnpm --filter @app/database run studio",
    "db:seed": "pnpm --filter @app/database run seed",
    "db:sync-current:dev": "pnpm --filter @app/database run sync-current:dev",
    "db:sync-current:production": "pnpm --filter @app/database run sync-current:production",
    "db:audit-analytics": "pnpm --filter @app/database run audit-analytics",
    "db:import-api-football": "pnpm --filter @app/database run import-api-football",
    "db:sync-live": "pnpm --filter @app/database run sync-live",
    "db:sync-live:watch": "pnpm --filter @app/database run sync-live:watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.12.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
