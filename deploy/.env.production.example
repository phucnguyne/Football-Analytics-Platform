# Supabase pooled or direct PostgreSQL connection URL for Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Public Vercel deployment URL. Both API and Socket.IO use this CORS allow-list.
WEB_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Must be shared by the Vercel web app and realtime service.
NEXTAUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Must be shared by API, realtime, and the sync worker.
INTERNAL_SERVICE_SECRET="replace-with-a-different-random-secret-at-least-32-characters"

FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_API_URL="https://api.football-data.org/v4"
