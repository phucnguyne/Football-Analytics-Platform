DATABASE_URL="postgresql://postgres:change_me@localhost:5433/football?schema=public"
NEXTAUTH_SECRET="replace-with-a-random-nextauth-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_API_URL="https://api.football-data.org/v4"

# API-Football (server-only; leave empty to use database/open-data fallbacks)
API_FOOTBALL_API_KEY=""
API_FOOTBALL_API_URL="https://v3.football.api-sports.io"
API_FOOTBALL_SEASON="2026"
API_FOOTBALL_LEAGUE_ID="39"
# JSON maps are needed when local football-data.org IDs differ from API-Football IDs.
API_FOOTBALL_FIXTURE_MAP="{}"
API_FOOTBALL_PLAYER_MAP="{}"
NEXT_PUBLIC_WEBSOCKET_URL="http://localhost:3001"

# HuggingFace StatsBomb dataset (private repo — create token at https://huggingface.co/settings/tokens)
HF_TOKEN=""
HF_DATASET_URL="https://huggingface.co/datasets/phucnguyne/statsbomb-open-data/resolve/main/data"
