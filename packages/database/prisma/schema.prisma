generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  username      String?   @unique
  avatar        String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  favorites   Favorite[]
  predictions Prediction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum Role {
  USER
  ADMIN
}

// ── Competition & Season ──────────────────────────────────────────────────────

model League {
  id      Int     @id
  name    String  @unique
  country String
  emblem  String?

  seasons Season[]
  matches Match[]

  @@map("leagues")
}

model Season {
  id        Int      @id @default(autoincrement())
  leagueId  Int
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  year      Int
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  matches   Match[]
  standings Standing[]
  teams     TeamSeason[]

  @@unique([leagueId, year])
  @@map("seasons")
}

// ── Team ──────────────────────────────────────────────────────────────────────

model Team {
  id        Int     @id
  name      String
  shortName String
  crest     String?
  founded   Int?
  venue     String?

  seasons      TeamSeason[]
  players      PlayerTeam[]
  homeMatches  Match[]       @relation("homeTeam")
  awayMatches  Match[]       @relation("awayTeam")
  standings    Standing[]
  stats        TeamStats?
  matchLineups MatchLineup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("teams")
}

model TeamSeason {
  teamId   Int
  seasonId Int
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([teamId, seasonId])
  @@map("team_seasons")
}

// ── Player ────────────────────────────────────────────────────────────────────

model Player {
  id          Int       @id
  name        String
  position    Position
  dateOfBirth DateTime?
  nationality String?
  photo       String?
  shirtNumber Int?

  teams         PlayerTeam[]
  stats         PlayerStats?
  events        MatchEvent[]  @relation("eventPlayer")
  relatedEvents MatchEvent[]  @relation("eventRelated")
  lineups       MatchLineup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("players")
}

model PlayerTeam {
  id          String    @id @default(cuid())
  playerId    Int
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId      Int
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  from        DateTime?
  to          DateTime?
  shirtNumber Int?

  @@index([playerId])
  @@index([teamId])
  @@map("player_teams")
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

// ── Match ─────────────────────────────────────────────────────────────────────

model Match {
  id          Int         @id
  utcDate     DateTime
  status      MatchStatus
  minute      Int?
  stage       String?
  matchday    Int?
  venueId     Int?
  refereeId   Int?
  attendance  Int?
  lastUpdated DateTime?

  homeTeamId Int
  homeTeam   Team @relation("homeTeam", fields: [homeTeamId], references: [id])

  awayTeamId Int
  awayTeam   Team @relation("awayTeam", fields: [awayTeamId], references: [id])

  leagueId Int
  league   League @relation(fields: [leagueId], references: [id])

  seasonId Int?
  season   Season? @relation(fields: [seasonId], references: [id])

  score       MatchScore?
  statistics  MatchStatistic[]
  events      MatchEvent[]
  lineups     MatchLineup[]
  predictions Prediction[]

  rawData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId])
  @@index([seasonId])
  @@index([status])
  @@index([utcDate])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@map("matches")
}

enum MatchStatus {
  SCHEDULED
  TIMED
  IN_PLAY
  PAUSED
  FINISHED
  POSTPONED
  CANCELLED
  SUSPENDED
}

model MatchScore {
  id                 String    @id @default(cuid())
  matchId            Int       @unique
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeTeamGoals      Int
  awayTeamGoals      Int
  homeTeamGoalsHT    Int?
  awayTeamGoalsHT    Int?
  scoreExtraTimeHome Int?
  scoreExtraTimeAway Int?
  scorePenaltyHome   Int?
  scorePenaltyAway   Int?
  winner             Winner?
  duration           Duration?

  @@map("match_scores")
}

enum Winner {
  HOME
  AWAY
  DRAW
}

enum Duration {
  REGULAR
  EXTRA_TIME
  PENALTY
}

model MatchEvent {
  id              String    @id @default(cuid())
  matchId         Int
  match           Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type            EventType
  minute          Int
  minuteExtra     Int?
  team            Side
  playerId        Int?
  player          Player?   @relation("eventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  relatedPlayerId Int?
  relatedPlayer   Player?   @relation("eventRelated", fields: [relatedPlayerId], references: [id], onDelete: SetNull)
  detail          String?

  @@index([matchId, minute])
  @@map("match_events")
}

enum EventType {
  GOAL
  OWN_GOAL
  PENALTY_GOAL
  PENALTY_MISSED
  YELLOW_CARD
  SECOND_YELLOW
  RED_CARD
  SUBSTITUTION
  VAR
}

model MatchStatistic {
  id            String @id @default(cuid())
  matchId       Int
  match         Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team          Side
  shots         Int?
  shotsOnTarget Int?
  possession    Int?
  passes        Int?
  passAccuracy  Float?
  fouls         Int?
  yellowCards   Int?
  redCards      Int?
  corners       Int?
  xG            Float?
  offsides      Int?
  saves         Int?

  @@unique([matchId, team])
  @@map("match_statistics")
}

model MatchLineup {
  id          String  @id @default(cuid())
  matchId     Int
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId      Int
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId    Int
  player      Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  isStarter   Boolean @default(true)
  position    String?
  shirtNumber Int?

  @@unique([matchId, teamId, playerId])
  @@index([matchId])
  @@map("match_lineups")
}

enum Side {
  HOME
  AWAY
}

// ── Standing ──────────────────────────────────────────────────────────────────

model Standing {
  id             String       @id @default(cuid())
  seasonId       Int
  season         Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId         Int
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type           StandingType @default(TOTAL)
  group          String?
  position       Int
  playedGames    Int
  wins           Int
  draws          Int
  losses         Int
  points         Int
  goalsFor       Int
  goalsAgainst   Int
  goalDifference Int
  updatedAt      DateTime     @updatedAt

  @@unique([seasonId, teamId, type, group])
  @@index([seasonId, position])
  @@map("standings")
}

enum StandingType {
  TOTAL
  HOME
  AWAY
}

// ── Stats ─────────────────────────────────────────────────────────────────────

model TeamStats {
  id               String   @id @default(cuid())
  teamId           Int      @unique
  seasonId         Int?
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  totalMatches     Int      @default(0)
  wins             Int      @default(0)
  draws            Int      @default(0)
  losses           Int      @default(0)
  goalsFor         Int      @default(0)
  goalsAgainst     Int      @default(0)
  avgGoalsPerMatch Float?
  updatedAt        DateTime @updatedAt

  @@map("team_stats")
}

model PlayerStats {
  id            String   @id @default(cuid())
  playerId      Int      @unique
  seasonId      Int?
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchesPlayed Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  minutesPlayed Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("player_stats")
}

// ── User Features ─────────────────────────────────────────────────────────────

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType FavType
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("favorites")
}

enum FavType {
  TEAM
  PLAYER
  LEAGUE
  MATCH
}

model Prediction {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId    Int
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  prediction PredResult
  confidence Float
  correct    Boolean?
  createdAt  DateTime   @default(now())

  @@unique([userId, matchId])
  @@index([userId])
  @@map("predictions")
}

enum PredResult {
  HOME_WIN
  AWAY_WIN
  DRAW
}

// ── Sync Log ──────────────────────────────────────────────────────────────────

model SyncLog {
  id         String     @id @default(cuid())
  entity     String
  status     SyncStatus
  message    String?
  itemCount  Int        @default(0)
  startTime  DateTime   @default(now())
  endTime    DateTime?
  durationMs Int?

  @@index([entity, startTime])
  @@map("sync_logs")
}

enum SyncStatus {
  SUCCESS
  FAILED
  RUNNING
}
