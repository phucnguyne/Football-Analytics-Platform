{
  "name": "@app/database",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "postinstall": "prisma generate",
    "seed": "prisma generate && tsx seed/seed.ts",
    "sync-current": "tsx scripts/sync-current.ts",
    "sync-current:dev": "tsx scripts/sync-current-env.ts development",
    "sync-current:production": "tsx scripts/sync-current-env.ts production",
    "audit-analytics": "tsx scripts/sync-current-env.ts --audit",
    "sync-live": "tsx scripts/sync-live.ts",
    "sync-live:watch": "tsx scripts/sync-live.ts --watch",
    "seed-statsbomb": "tsx scripts/seed-statsbomb.ts",
    "seed-statsbomb:events": "tsx scripts/seed-statsbomb.ts --events --lineups",
    "seed-statsbomb:dry": "tsx scripts/seed-statsbomb.ts --dry-run",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@prisma/client": "^5.12.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "prisma": "^5.12.0",
    "tsx": "^4.16.2"
  }
}
